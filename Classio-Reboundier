 task.spawn(function()
  while gui.Parent do
   bg.BackgroundColor3 = config.Flashing[2]

   task.wait(
    math.random(60, 100) / 1000
   )

   bg.BackgroundColor3 = Color3.new(0, 0, 0)

   task.wait(
    math.random(80, 100) / 1000
   )
  end
 end)
end

--// SHAKE
