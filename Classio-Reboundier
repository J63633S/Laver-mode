local face = Instance.new("ImageLabel")
face.AnchorPoint = Vector2.new(0.5, 0.5)
face.Position = UDim2.new(0.5, 0, 0.5, 0)
face.Size = UDim2.new(1, 0, 1, 0)
face.BackgroundTransparency = 1
face.Image = config.Image1
face.ResampleMode = Enum.ResamplerMode.Pixelated
face.ZIndex = 1000
face.Parent = bg

--// SIZES
local screenY = gui.AbsoluteSize.Y

local minSize = screenY / 5
local maxSize = screenY / 2.5

--// TEASE SOUNDS
local sound1, sound2

if config.Sound1 then
 sound1 = loadSound(config.Sound1)
end

if config.Sound2 then
 sound2 = loadSound(config.Sound2)
end

--// TEASE
if config.Tease and config.Tease[1] then

 local loops = math.random(
  config.Tease.Min,
  config.Tease.Max
 )

 if sound1 then
  sound1:Play()
 end

 --// START AT SMALL SIZE
 face.Size = UDim2.new(
  0,
  minSize,
  0,
  minSize
 )

 --// HOW MUCH IT GROWS EACH STEP
 local grow = (maxSize - minSize) / loops

 --// GET CLOSER → WAIT → GET CLOSER → WAIT
 for i = 1, loops do

  -- Get closer
  face.Size = face.Size + UDim2.new(
   0,
   grow,
   0,
   grow
  )

  -- Wait before getting closer again
  task.wait(math.random(
   config.Tease.StepDelayMin * 100,
   config.Tease.StepDelayMax * 250
  ) / 250)
 end
end

--// FLASHING
