local config = {
 Image1 = "rbxassetid://85732345868205",
 Image2 = "rbxassetid://85732345868205",

 Shake = true,

 Sound1 = {0, {Volume = 8}},
 Sound2 = {116282238939992, {Volume = 10}},

 Flashing = {
